{
  "name": "webinar-recorder",
  "productName": "Webinar Recorder",
  "version": "3.0.0",
  "description": "Настольная запись вебинаров со звуком в фоне",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests-desktop/*.test.cjs",
    "test:desktop": "node tests-desktop/integration.cjs",
    "build:portable": "python3 scripts/package.py",
    "dist:win": "electron-builder --config electron-builder.cjs --win nsis --x64",
    "pack:win": "electron-builder --config electron-builder.cjs --win --x64 --dir",
    "test:capture": "node tests-desktop/external-capture.cjs",
    "test:features": "node tests-desktop/features.cjs"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "playwright": "1.65.1",
    "ffmpeg-static": "5.3.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "author": "BomBilka1",
  "repository": {
    "type": "git",
    "url": "https://github.com/BomBilka1/webinar-recorder.git"
  }
}
